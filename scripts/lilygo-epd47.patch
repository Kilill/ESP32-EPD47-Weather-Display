+void epd_push_pixels_circle(int32_t x0, int32_t y0, int32_t r, int16_t time, int32_t color)
+{
+    uint8_t row[EPD_LINE_BYTES] = { 0 };
+
+    // Calculate bounding box for the circle
+    int32_t y_start = y0 - r;
+    int32_t y_end = y0 + r;
+    
+    if (y_start < 0) y_start = 0;
+    if (y_end >= EPD_HEIGHT) y_end = EPD_HEIGHT - 1;
+
+    epd_start_frame();
+
+    for (int32_t y = 0; y < EPD_HEIGHT; y++)
+    {
+        // Clear row buffer
+        memset(row, 0, EPD_LINE_BYTES);
+        
+        // Check if this row intersects the circle
+        if (y >= y_start && y <= y_end)
+        {
+            // Calculate x range for this y using circle equation: x^2 + y^2 = r^2
+            int32_t dy = y - y0;
+            int32_t dx = (int32_t)sqrt(r * r - dy * dy);
+            
+            int32_t x_start = x0 - dx;
+            int32_t x_end = x0 + dx;
+            
+            if (x_start < 0) x_start = 0;
+            if (x_end >= EPD_WIDTH) x_end = EPD_WIDTH - 1;
+            
+            // Fill the row buffer for this circle segment
+            for (int32_t x = x_start; x <= x_end; x++)
+            {
+                uint32_t position = x % 4;
+                uint8_t mask = (color ? CLEAR_BYTE : DARK_BYTE) & (0b00000011 << (2 * position));
+                row[x / 4] |= mask;
+            }
+            
+            reorder_line_buffer((uint32_t *)row);
+            
+            epd_switch_buffer();
+            memcpy(epd_get_current_buffer(), row, EPD_LINE_BYTES);
+            epd_switch_buffer();
+            memcpy(epd_get_current_buffer(), row, EPD_LINE_BYTES);
+
+            write_row(time * 10);
+        }
+        else if (y < y_start)
+        {
+            skip_row(time);
+        }
+        else if (y == y_start)
+        {
+            // First row of circle area - setup buffers
+            reorder_line_buffer((uint32_t *)row);
+            
+            epd_switch_buffer();
+            memcpy(epd_get_current_buffer(), row, EPD_LINE_BYTES);
+            epd_switch_buffer();
+            memcpy(epd_get_current_buffer(), row, EPD_LINE_BYTES);
+
+            write_row(time * 10);
+        }
+        else
+        {
+            skip_row(time);
+        }
+    }
+    
+    // Latch out the last row
+    write_row(time * 10);
+
+    epd_end_frame();
+}
+
+
+void epd_clear_circle_cycles(int32_t x0, int32_t y0, int32_t r, int32_t cycles, int32_t cycle_time)
+{
+    const int16_t white_time = cycle_time;
+    const int16_t dark_time = cycle_time;
+
+    for (int32_t c = 0; c < cycles; c++)
+    {
+        for (int32_t i = 0; i < 4; i++)
+        {
+            epd_push_pixels_circle(x0, y0, r, dark_time, 0);
+        }
+        for (int32_t i = 0; i < 4; i++)
+        {
+            epd_push_pixels_circle(x0, y0, r, white_time, 1);
+        }
+    }
+}
+
+
+void epd_clear_circle(int32_t x0, int32_t y0, int32_t r)
+{
+    epd_clear_circle_cycles(x0, y0, r, 4, 50);
+}
