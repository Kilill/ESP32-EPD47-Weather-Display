#ifndef SECRETS_H
#define SECRETS_H

// =============================================================================
// SENSITIVE CONFIGURATION - DO NOT COMMIT TO GIT
// =============================================================================
// 
// This file contains sensitive information like passwords and API keys.
// 
// SETUP INSTRUCTIONS:
// 1. Copy this file to secrets.h:
//    cp secrets.h.example secrets.h
// 
// 2. Edit secrets.h with your actual credentials
// 
// 3. Never commit secrets.h to version control (it's in .gitignore)
//
// =============================================================================

// =============================================================================
// WiFi Credentials
// =============================================================================

#define WIFI_SSID               "your_wifi_ssid"
#define WIFI_PASSWORD           "your_wifi_password"

// =============================================================================
// MQTT Broker Settings
// =============================================================================

// MQTT Broker URI
// Examples:
//   mqtt://broker.example.com:1883        (no encryption)
//   mqtts://broker.example.com:8883       (TLS/SSL encryption)
//   mqtt://192.168.1.100:1883             (local broker)
#define MQTT_BROKER_URI         "mqtt://broker.example.com:1883"

// MQTT Authentication (leave empty strings "" if not required)
#define MQTT_USERNAME           ""
#define MQTT_PASSWORD           ""

// =============================================================================
// Web Server Settings
// =============================================================================

// Base URL for the Weather API (historical data)
// Example: https://weather.killhome.itr.no:4433/weatherAPI
// Note: Do NOT include the endpoint path (e.g., /history) here
#define WEBSERVER_URL           "https://weather.example.com/weatherAPI"

// Optional: API key or token if required by your web server
#define WEBSERVER_API_KEY       ""

#endif // SECRETS_H
